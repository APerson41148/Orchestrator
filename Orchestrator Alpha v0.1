current_os = platform.system().lower()

active_theme = "#181825"
silly_value = 0

def unstringify_color(color):
    clean_hex = color.lstrip("#")
    r = int(clean_hex[0:2], 16)
    g = int(clean_hex[2:4], 16)
    b = int(clean_hex[4:6], 16)
    return r, g, b

def set_background(hex_color):
    """Changes the background color of the main content area"""
    content_container.setStyleSheet(
        f"QWidget#contentContainer {{ background-color: {hex_color}; }}"
    )


def on_brightness(value, color=None):
    """Dynamically adjust background brightness cleanly between 0% and 100%"""
    global active_theme
    if color is not None:
        active_theme = color

    r, g, b = unstringify_color(active_theme)
    factor = value / 25.0

    r_adj = min(255, max(0, int(r * factor)))
    g_adj = min(255, max(0, int(g * factor)))
    b_adj = min(255, max(0, int(b * factor)))

    custom_color = f"#{r_adj:02x}{g_adj:02x}{b_adj:02x}"
    set_background(custom_color)


def background_slider_update(value):
    """Updates the brightness label and background when slider moves"""
    background_value_label.setText(f"Brightness: {value}%")
    on_brightness(value)


def update_home_title():
    """Dynamically randomizes title text based on Sillyness level"""
    if silly_value > 50:
        silly_quotes = [
            "Six Seven!",
            "Are You A Fatty?",
            "Get off of your computer and go outside! Do a situp or something!",
            "Wassup!",
            "What is the meaning of life?",
            "Why is the sky blue?",
        ]
        home_label.setText(random.choice(silly_quotes))
    else:
        home_label.setText("Welcome Back!")


def silly_slider_update(value):
    """Updates the sillyness label and recalculates title text"""
    global silly_value
    silly_value = value
    silly_value_label.setText(f"Sillyness: {value}%")
    update_home_title()


def open_url(url):
    """Clean cross-platform browser opener"""
    webbrowser.open(url)


def on_search():
    """Searches Google or opens direct URL when pressing Enter"""
    query = search_bar.text().strip()
    if query:
        search_recommendations.on_search(query)
        search_bar.clear()


def orchestrator_click(button_name):
    if button_name == "Gmail":
        open_url("https://mail.google.com/mail/u/0/#inbox")
    elif button_name == "AoPS":
        open_url("https://artofproblemsolving.com/")
    elif button_name == "Google":
        open_url("https://www.google.com/")
    elif button_name == "Quit":
        sys.exit(0)
    elif button_name == "Home":
        update_home_title()
        stacked_widget.setCurrentWidget(home_page)
    elif button_name == "Web Apps":
        stacked_widget.setCurrentWidget(web_apps_page)
    elif button_name == "Settings":
        stacked_widget.setCurrentWidget(settings_page)


