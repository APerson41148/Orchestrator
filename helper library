import platform
import subprocess
import sys

if sys.platform == "win32":
    import winreg

current_os = platform.system().lower()


def open_in_all_browsers(url):
    """Attempts to launch all installed web browsers"""
    os_name = sys.platform
    commands = []

    if os_name == "win32":
        commands = [
            ["cmd", "/c", f"start chrome {url}"],
            ["cmd", "/c", f"start firefox {url}"],
            ["cmd", "/c", f"start msedge {url}"],
        ]
    elif os_name == "darwin":  # macOS
        commands = [
            ["open", "-a", "Google Chrome", url],
            ["open", "-a", "Firefox", url],
            ["open", "-a", "Safari", url],
            ["open", "-a", "Microsoft Edge", url],
        ]
    elif os_name.startswith("linux"):
        commands = [
            ["google-chrome", url],
            ["firefox", url],
            ["microsoft-edge", url],
        ]

    for cmd in commands:
        try:
            subprocess.Popen(
                cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
            )
        except Exception:
            continue


def on_search(query):
    """Parses query string and launches search or opens URL"""
    query = query.strip()
    if not query:
        return

    if query.startswith("http://") or query.startswith("https://"):
        target_url = query
    elif "." in query and " " not in query:
        target_url = f"https://{query}"
    else:
        target_url = f"https://www.google.com/search?q={query}"

    open_in_all_browsers(target_url)
